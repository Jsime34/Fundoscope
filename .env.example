# Copy to .env and fill in the blanks. Never commit .env.
# The database values are local-development defaults only.

# --- Database (used by docker compose and the backend) ---
POSTGRES_USER=fundoscope
POSTGRES_PASSWORD=fundoscope
POSTGRES_DB=fundoscope
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://fundoscope:fundoscope@localhost:5433/fundoscope

# --- Copernicus Data Space Ecosystem: Sentinel Hub OAuth client ---
# Create at https://shapps.dataspace.copernicus.eu/dashboard -> User settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Quota guard: Sentinel Hub processing units per month (free tier = 10,000) ---
QUOTA_PU_MONTHLY_CAP=8000
